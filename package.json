{
  "name": "cratecraft",
  "productName": "crateCraft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build_frontend.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p e2e && eslint src e2e && vitest run && node scripts/build_frontend.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-data-grid": "9.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-storybook": "10.6.7",
    "jsdom": "31.0.0",
    "storybook": "10.6.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
