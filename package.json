{
  "name": "cratecraft",
  "productName": "crateCraft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build_frontend.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p e2e && eslint src e2e && vitest run && node scripts/build_frontend.mjs --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
